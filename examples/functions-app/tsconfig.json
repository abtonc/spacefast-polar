{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    // Resolves the SDK from this repo's source, so the example typechecks
    // before the package is published. Delete `paths` in your own project.
    "paths": {
      "spacefast-polar": ["../../src/core/index.ts"],
      "spacefast-polar/functions": ["../../src/functions/index.ts"]
    }
  },
  "include": ["functions"]
}
